    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"loader = QuantumDataLoader()\\n\",\n",
    "    \"\\n\",\n",
    "    \"X_quantum, y = loader.prepare_fraud_data(df)\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f\\\"Features for the circuit: {X_quantum.shape}\\\")\\n\",\n",
    "    \"print(f\\\"Labels: {y.shape}\\\")\"\n",
    "   ],\n",
    "   \"id\": \"c7298728cd7241c3\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"Features for the circuit: (284807, 32)\\n\",\n",
    "      \"Labels: (284807,)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 7\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {\n",
    "    \"ExecuteTime\": {\n",
    "     \"end_time\": \"2026-03-09T18:32:31.442702Z\",\n",
    "     \"start_time\": \"2026-03-09T18:32:31.407931Z\"\n",
    "    }\n",
    "   },\n",
    "   \"cell_type\": \"code\",\n",
    "   \"source\": [\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"One-class Training:\\n\",\n",
    "    \"Separation into normal and fraudulent examples\\n\",\n",
    "    \"QSVDD will learn what is normal.\\n\",\n",
    "    \"\\\"\\\"\\\"\\n\",\n",
    "    \"normal_indices = np.where(y == 0)[0]\\n\",\n",
    "    \"abnormal_indices = np.where(y == 1)[0]\\n\",\n",
    "    \"np.random.seed(42)\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Train\\n\",\n",
    "    \"# collect 1000 normal examples for training\\n\",\n",
    "    \"X_train_normal_indices = np.random.choice(normal_indices, 1000, replace=False)\\n\",\n",
    "    \"X_train_normal = X_quantum[X_train_normal_indices]\\n\",\n",
    "    \"y_train_normal = y[X_train_normal_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# X_train contains only legitimate transactions\\n\",\n",
    "    \"X_train = X_train_normal\\n\",\n",
    "    \"Y_train = y_train_normal\\n\",\n",
    "    \"\\n\",\n",
    "    \"# Test (balanced)\\n\",\n",
    "    \"# The code removes 100 normal examples that were not used in training\\n\",\n",
    "    \"remaining_normal_indices = list(set(normal_indices) - set(X_train_normal_indices))\\n\",\n",
    "    \"X_test_normal_indices = np.random.choice(remaining_normal_indices, 100, replace=False)\\n\",\n",
    "    \"X_test_normal = X_quantum[X_test_normal_indices]\\n\",\n",
    "    \"y_test_normal = y[X_test_normal_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# The code removes 100 fraud examples.\\n\",\n",
    "    \"X_test_abnormal_indices = np.random.choice(abnormal_indices, 100, replace=False)\\n\",\n",
    "    \"X_test_abnormal = X_quantum[X_test_abnormal_indices]\\n\",\n",
    "    \"y_test_abnormal = y[X_test_abnormal_indices]\\n\",\n",
    "    \"\\n\",\n",
    "    \"# creates a test set with 200 examples (50% normal, 50% fraud)\\n\",\n",
    "    \"X_test = np.concatenate((X_test_normal, X_test_abnormal), axis=0)\\n\",\n",
    "    \"Y_test = np.concatenate((y_test_normal, y_test_abnormal), axis=0)\\n\",\n",
    "    \"\\n\",\n",
    "    \"center = np.zeros(latent_dim)\\n\",\n",
    "    \"center_train = np.tile(center, (len(X_train), 1))\\n\",\n",
    "    \"\\n\",\n",
    "    \"print(f'X_train shape: {X_train.shape}')\\n\",\n",
    "    \"print(f'Y_train shape: {Y_train.shape}')\\n\",\n",
    "    \"print(f'X_test_normal shape: {X_test_normal.shape}')\\n\",\n",
    "    \"print(f'X_test_abnormal shape: {X_test_abnormal.shape}')\\n\",\n",
    "    \"print(f'X_test shape: {X_test.shape}')\\n\",\n",
    "    \"print(f'Y_test shape: {Y_test.shape}')\\n\",\n",
    "    \"print(f'center_train shape: {center_train.shape}')\"\n",
    "   ],\n",
    "   \"id\": \"a52e9c1c39f9fd52\",\n",
    "   \"outputs\": [\n",
    "    {\n",
    "     \"name\": \"stdout\",\n",
    "     \"output_type\": \"stream\",\n",
    "     \"text\": [\n",
    "      \"X_train shape: (1000, 32)\\n\",\n",
    "      \"Y_train shape: (1000,)\\n\",\n",
    "      \"X_test_normal shape: (100, 32)\\n\",\n",
    "      \"X_test_abnormal shape: (100, 32)\\n\",\n",
    "      \"X_test shape: (200, 32)\\n\",\n",
    "      \"Y_test shape: (200,)\\n\",\n",
    "      \"center_train shape: (1000, 3)\\n\"\n",
    "     ]\n",
    "    }\n",
    "   ],\n",
    "   \"execution_count\": 8\n",
    "  },\n",
    "  {\n",
    "   \"metadata\": {},\n",
    "   \"cell_type\": \"markdown\",\n",
    "   \"source\": \"### Noiseless Training\",\n",
    "   \"id\": \"82650afd8e45d4f7\"\n",
    "  },\n",
    "  {\n",
